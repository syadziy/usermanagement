# =========================
# APPLICATION
# =========================
SPRING_PROFILES_ACTIVE=local
AUTH_COOKIE_NAME=ACCESS_TOKEN
AUTH_COOKIE_PATH=/
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Strict

# =========================
# DATABASE
# =========================
DB_URL=jdbc:postgresql://localhost:5432/usermanagement
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=2
DEFAULT_SUPERADMIN_PASSWORD_HASH=

# =========================
# SERVER
# =========================
SERVER_PORT=9005

# =========================
# USER MANAGEMENT
# =========================
JWT_ISSUER=http://localhost:9005
JWT_KEY_ID=usermanagement-local
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_GENERATE_EPHEMERAL_KEY=true
JWT_AUDIENCES=api-gateway
TENANT_REGISTRATION_ENABLED=true

# =========================
# CENTRALIZED AUDIT / ALERT
# =========================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
USERMANAGEMENT_AUDIT_ENABLED=true
USERMANAGEMENT_AUDIT_TOPIC=centralized-audit.requested
USERMANAGEMENT_AUDIT_SOURCE_SYSTEM=USERMANAGEMENT-SERVICE
USERMANAGEMENT_AUDIT_FALLBACK_ACTOR_ID=usermanagement-service
USERMANAGEMENT_ERROR_ALERT_ENABLED=true
CENTRALIZED_ALERT_URL=http://localhost:9003/api/v1/alert
USERMANAGEMENT_ERROR_ALERT_SENDER_EMAIL=usermanagement@example.com
USERMANAGEMENT_ERROR_ALERT_SENDER_NAME=User Management Service
USERMANAGEMENT_ERROR_ALERT_RECIPIENTS=ops@example.com
USERMANAGEMENT_ERROR_ALERT_AUTHORIZATION_HEADER=
USERMANAGEMENT_ERROR_ALERT_TIMEOUT=PT10S

# =========================
# SHARED SDK
# =========================
APP_TIMEZONE=UTC

# =========================
# MANAGEMENT / ACTUATOR
# =========================
TRACING_SAMPLING_PROBABILITY=0.1

# =========================
# LOGGING
# =========================
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APPLICATION=INFO
LOG_LEVEL_SECURITY=INFO
