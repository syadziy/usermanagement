# =========================
# APPLICATION
# =========================
SPRING_PROFILES_ACTIVE=local

# =========================
# DATABASE
# =========================
DB_URL=jdbc:postgresql://postgresdb:5432/usermanagement
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=2

# =========================
# SERVER
# =========================
SERVER_PORT=9005

# =========================
# USER MANAGEMENT
# =========================
JWT_ISSUER=http://localhost:9005
JWT_KEY_ID=usermanagement-local
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_GENERATE_EPHEMERAL_KEY=true
JWT_AUDIENCES=api-gateway
TENANT_REGISTRATION_ENABLED=true

# =========================
# SHARED SDK
# =========================
APP_TIMEZONE=UTC

# =========================
# MANAGEMENT / ACTUATOR
# =========================
TRACING_SAMPLING_PROBABILITY=0.1

# =========================
# LOGGING
# =========================
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APPLICATION=INFO
LOG_LEVEL_SECURITY=INFO
